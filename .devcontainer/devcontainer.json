{
    "name": "مين الأسبق",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        }
    },
    "containerEnv": {
        "XDEBUG_MODE": "off"
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postAttachCommand": "echo '👉 لتشغيل اللعبة:  php artisan serve'",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "مين الأسبق",
            "onAutoForward": "openBrowser"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "onecentlab.laravel-blade",
                "bradlc.vscode-tailwindcss"
            ]
        }
    }
}
